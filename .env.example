NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=agenda
DB_PASSWORD=change-me
DB_NAME=agenda
DB_SYNCHRONIZE=false

# At least 32 random characters. Never commit the production value.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Comma-separated exact origins, without trailing slash.
CORS_ORIGIN=http://localhost:5176
SWAGGER_ENABLED=true

# Set true in production after assigning subscriptions/trials to existing businesses.
SUBSCRIPTIONS_ENFORCED=false

# Stripe Billing. Keep disabled until Products/Prices, portal and webhook are configured.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5176/agenda
STRIPE_AUTOMATIC_TAX=false
STRIPE_COLLECT_TAX_ID=true

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# External integrations (optional until providers are selected).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp reminders. Disabled by default: no outbound message is ever sent
# unless WHATSAPP_ENABLED=true. When enabled, WHATSAPP_API_URL (HTTP/S) and
# WHATSAPP_TOKEN are required. The provider is a generic HTTP endpoint.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=http
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TIMEOUT_MS=5000

# CRM CSV import safety limit (rows per request, header excluded).
CRM_IMPORT_MAX_ROWS=1000

# One-time admin bootstrap (only required by npm run admin:create).
# ADMIN_NAME=Platform Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PHONE=5550000000
# ADMIN_PASSWORD=replace-with-a-strong-password
